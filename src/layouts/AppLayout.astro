---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  active: 'admin';
}

const { title, description } = Astro.props;
const canonical = new URL('/', 'https://field-track.sassmaker.com');
const socialImage = new URL('/social.jpg', canonical);
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${canonical.href}#site`,
      name: 'Field Track',
      url: canonical.href,
      description,
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical.href}#demo`,
      name: 'Field Track synthetic manager demo',
      url: canonical.href,
      description,
      isPartOf: { '@id': `${canonical.href}#site` },
      audience: {
        '@type': 'Audience',
        audienceType: 'Managers of small field teams using managed Android phones',
      },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#153f36" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="text/markdown" href={new URL('/index.md', canonical)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Field Track" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Field Track synthetic manager dashboard with location freshness, a route map, and an employee roster." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <title>{title}</title>
    <script is:inline async src="https://www.clarity.ms/tag/y6bwivrpqg"></script>
    <script is:inline>
      !function(t,e){var o,a,r;function s(e){(o=t._phq=t._phq||[]).push([].slice.call(e))}o=t.posthog=function(e,n){s([e,n])},o.__loaded||(a=e.createElement("script"),a.type="text/javascript",a.async=!0,a.crossOrigin="anonymous",a.src="https://us.i.posthog.com/array.js",r=e.getElementsByTagName("script")[0],r.parentNode.insertBefore(a,r),o.__loaded=!0),t.posthog.init("phc_qgiAarw4Co4pw9fz3Fxj4UJaHmqzFetqs4JrXhGc35Nd",{api_host:"https://us.i.posthog.com",person_profiles:"always",capture_pageview:!1,autocapture:!1,loaded:function(){t.posthog.capture("page_view",{project_id:"field-track"})}})}(window,document);
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href="/admin" aria-label="Field Track home">
        <span class="wordmark-symbol" aria-hidden="true">FT</span>
        <span>Field Track<small>Shift location operations</small></span>
      </a>
      <nav aria-label="Product areas">
        <a href="/admin" aria-current="page">Manager dashboard</a>
      </nav>
    </header>
    <aside class="demo-status" aria-label="Public demo availability">
      <strong><span aria-hidden="true"></span>Interactive synthetic demo</strong>
      <p>Explore the real manager dashboard with fictional employees and routes.</p>
      <span class="demo-status__availability">Held: economics + real-device testing open</span>
    </aside>
    <aside class="tracking-boundary" aria-label="Managed tracking boundary">
      <strong>Managed tracking boundary</strong>
      <p>After administrator enrollment, the employee app has no start, stop, pause, or unenroll control. Android keeps its location notification visible. The phone queues points through weak 4G; server policy decides which points count as on duty.</p>
    </aside>
    <main id="main-content"><slot /></main>
    <footer class="site-footer">
      <span>Field Track public demo</span>
      <span>Synthetic data only · Economics and physical Android testing remain open</span>
      <span>Microsoft Clarity measures this credential-free synthetic demo only.</span>
    </footer>
    <script
      is:inline
      src="https://sassmaker.com/project-strip.js"
      data-project="field-track"
      defer
    ></script>
    <script
      is:inline
      src="https://sassmaker.com/ai-chat-footer.js"
      data-name="Field Track"
      defer
    ></script>
  </body>
</html>
