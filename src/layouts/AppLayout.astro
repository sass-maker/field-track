---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  active: 'admin';
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#153f36" />
    <meta name="description" content={description} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <title>{title} · Field Track</title>
    <script is:inline>
      !function(t,e){var o,n,a,r,i;function s(e){(o=t._phq=t._phq||[]).push([].slice.call(e))}o=t.posthog=function(e,n){s([e,n])},o.__loaded||(a=e.createElement("script"),a.type="text/javascript",a.async=!0,a.crossOrigin="anonymous",a.src="https://us.i.posthog.com/array.js",r=e.getElementsByTagName("script")[0],r.parentNode.insertBefore(a,r),o.__loaded=!0),t.posthog.init("phc_qgiAarw4Co4pw9fz3Fxj4UJaHmqzFetqs4JrXhGc35Nd",{api_host:"https://us.i.posthog.com",person_profiles:"always",capture_pageview:!1,autocapture:!1,loaded:function(){t.posthog.capture("page_view",{project_id:"field-track"})}})}(window,document);
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href="/admin" aria-label="Field Track home">
        <span class="wordmark-symbol" aria-hidden="true">FT</span>
        <span>Field Track<small>Shift location operations</small></span>
      </a>
      <nav aria-label="Product areas">
        <a href="/admin" aria-current="page">Manager dashboard</a>
      </nav>
    </header>
    <main id="main-content"><slot /></main>
    <footer class="site-footer">
      <span>Field Track MVP</span>
      <span>Managed Android devices report continuously; server policy controls retention.</span>
    </footer>
  </body>
</html>
